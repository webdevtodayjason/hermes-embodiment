# embody — configuration (the user-facing schema).
#
# On install, `hermes plugins install` copies this file to
#   ~/.hermes/plugins/embody/config.yaml   (never clobbering an existing one).
# The plugin loads that config itself, applying the built-in defaults below for
# every missing key — so a bare box with NO config file still runs as
# "animated face in a browser + TTS on the default sink".
#
# Nothing here is hardcoded in code. "Minnie" is just an example instance:
# see examples/minnie/config.yaml.

persona:
  name: "Assistant"            # face nameplate + page title (face-ui reads persona.name via /config)
  wake_word: "hey assistant"   # reserved for a future STT wave; unused at first-light

voice:
  enabled: true                # false => never synthesize/play speech
  provider: ""                 # "" => inherit Hermes tts.provider (currently elevenlabs)
  voice_id: ""                 # "" => inherit Hermes tts.elevenlabs.voice_id (currently "Adam")
  speak_on: "post_llm_call"    # which hook drives speech (advanced; first-light = post_llm_call)
  stream:                      # STREAMING TTS: she starts talking in ~hundreds of ms (ElevenLabs only)
    enabled: true              # false => always synth the whole reply, then play (the fallback path)
    model_id: "eleven_flash_v2_5"   # low-latency ElevenLabs streaming model
    sample_rate: 24000         # pcm_24000 (s16le mono); per-chunk RMS drives the live mouth via /events

audio:
  backend: "auto"              # auto | pipewire | alsa | hermes-default | off
                               #   auto => pipewire if `paplay` present, else alsa if `aplay`,
                               #           else Hermes' own player. off => silent (face/LEDs only).
  device: ""                   # PipeWire sink name OR ALSA device. "" => system default sink.
                               #   example (a Pi pinned to HDMI):
                               #   "alsa_output.platform-107c701400.hdmi.hdmi-stereo"

voice_input:                   # push-to-talk voice INPUT: PTT -> record -> local STT -> agent turn
  enabled: false               # opt-in; needs the ~/.embody-stt venv + a mic + the webhook platform enabled
  max_seconds: 30              # hard cap (s) so a stuck PTT button can't record forever
  stt_venv: "~/.embody-stt"    # isolated faster-whisper venv; transcription runs by SUBPROCESS (never imported)
  stt_model: "base"            # whisper model name cached in that venv
  mic_source: ""               # "" => default PipeWire source (e.g. the Samson Go Mic)
  webhook:                     # transcript is POSTed here -> a real agent turn -> Minnie replies aloud
    host: "127.0.0.1"          # loopback: the gateway webhook platform must bind 127.0.0.1
    port: 8644                 # gateway webhook port (platforms.webhook.extra.port)
    route: "voice"             # POST /webhooks/<route>  (subscribe with: hermes webhook subscribe voice ...)
    secret: ""                 # HMAC secret; MUST equal the platforms.webhook route's secret

face:
  enabled: true                # always-on web transport (face page + SSE + /config)
  host: "127.0.0.1"
  port: 8830
  theme: "default"             # face-ui reads this as top-level `theme` via /config
  mood_hold: 8                 # seconds a non-neutral mood lingers before decaying back to neutral
  kiosk:                       # OPTIONAL — not wired at first-light; a deploy-time step
    enabled: false             # true => launch a dedicated kiosk browser at the face URL
    user_data_dir: "~/.embody-kiosk"
    command: ""                # "" => auto-build chromium --kiosk --app=<url>; override for other browsers

leds:
  backend: "auto"              # auto (active iff `pironman5` on PATH) | pironman | off
  brightness: 60               # global default brightness 0-100 (per-state may override)
  states:                      # state -> { color: <6-hex no #>, style: <solid|breathing|flow|...> }
    idle:     { color: "1E3A5F", style: "breathing" }
    thinking: { color: "FFB000", style: "flow" }
    working:  { color: "8000FF", style: "solid" }
    speaking: { color: "00C853", style: "flow" }
  moods:                       # mood -> { color: <6-hex no #> }  (emotional tint, independent of state)
    neutral:   { color: "1E3A5F" }   # calm blue   (also the decay target)
    happy:     { color: "FFC107" }   # warm amber
    excited:   { color: "FF6D00" }   # bright orange
    loving:    { color: "FF2D78" }   # pink
    playful:   { color: "00E5FF" }   # cyan
    curious:   { color: "7C4DFF" }   # violet
    sad:       { color: "2962FF" }   # deep blue
    surprised: { color: "EAEAEA" }   # near-white
    concerned: { color: "FF7043" }   # amber-red

oled:
  backend: "auto"              # auto | pironman | off  (OPTIONAL; backend module shipped separately)
