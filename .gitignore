# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtualenvs ---
venv/
.venv/
env/

# --- Active runtime config (NEVER ignore the example or the showcase) ---
# Root-anchored so it only matches a local dev copy at the repo root.
# `config.yaml.example` and `examples/minnie/config.yaml` stay tracked.
/config.yaml

# --- Editor / OS cruft ---
*.bak
*.bak*
*.swp
*~
.DS_Store
.idea/
.vscode/

# --- Local-only docs assets (e.g. unshared kiosk photos) ---
/docs/*.local.*

# --- Voice recordings & bulky/unoptimized media (keep out of the public repo) ---
# NOTE: the optimized hero GIF (img/minnie-faces-animated-optimized.gif) stays TRACKED.
*.m4a
*.wav
/img/miinie-01.png
/img/minnie-faces-animated.gif

# --- SSH keys / secrets must NEVER be committed ---
id_rsa
id_ed25519
*.pem
*_key
*_key.pub
.ssh/
